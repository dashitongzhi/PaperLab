{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "paperlab://schemas/v1/literature-provenance.json",
  "title": "Literature Provenance",
  "description": "Tracks the origin of literature used in a paper: search terms, databases queried, dates, inclusion/exclusion rationale, stable identifiers.",
  "type": "object",
  "required": ["id", "search_terms", "databases", "search_date", "status"],
  "properties": {
    "id":               { "type": "string", "pattern": "^L[0-9]{3,}$" },
    "search_terms":     { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "databases":        { "type": "array", "items": { "enum": ["arxiv", "pubmed", "biorxiv", "semantic_scholar", "openalex", "google_scholar", "manual"] }, "minItems": 1 },
    "search_date":      { "type": "string", "format": "date" },
    "date_window": {
      "type": "object",
      "properties": {
        "from": { "type": "string", "format": "date" },
        "to":   { "type": "string", "format": "date" }
      }
    },
    "inclusion_criteria":  { "type": "array", "items": { "type": "string" } },
    "exclusion_criteria":  { "type": "array", "items": { "type": "string" } },
    "results_count":       { "type": "integer", "minimum": 0 },
    "included_count":      { "type": "integer", "minimum": 0 },
    "stable_ids":          { "type": "array", "items": { "type": "string" } },
    "status":              { "enum": ["draft", "in_progress", "complete"] },
    "notes":               { "type": "string" }
  }
}
