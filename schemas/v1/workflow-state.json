{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "paperlab://schemas/v1/workflow-state.json",
  "title": "Workflow State",
  "description": "Captures a single PaperLab run's runtime configuration: prompt, tools, model, env, run id. Used to reproduce a paper-writing session.",
  "type": "object",
  "required": ["run_id", "started_at", "dsh_version"],
  "properties": {
    "run_id":     { "type": "string" },
    "started_at": { "type": "string", "format": "date-time" },
    "ended_at":   { "type": "string", "format": "date-time" },
    "dsh_version":{ "type": "string" },
    "paperlab_version": { "type": "string" },
    "model": {
      "type": "object",
      "properties": {
        "provider": { "type": "string" },
        "name":     { "type": "string" }
      }
    },
    "system_prompt_hash": { "type": "string" },
    "tools_loaded":       { "type": "array", "items": { "type": "string" } },
    "skills_loaded":      { "type": "array", "items": { "type": "string" } },
    "subagents_used":     { "type": "array", "items": { "type": "string" } },
    "env":                { "type": "object", "additionalProperties": { "type": "string" } },
    "working_directory":  { "type": "string" },
    "notes":              { "type": "string" }
  }
}
